rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signed(){return request.auth != null;}
    function me(){return request.auth.uid;}
    function profile(){return firestore.get(/databases/(default)/documents/users/$(me())).data;}
    function managerOf(uid){return signed() && profile().role in ['rh','admin'] && (profile().role=='admin' || firestore.get(/databases/(default)/documents/users/$(uid)).data.rhUid==me());}
    match /atestados/{uid}/{name}{
      allow read: if signed() && (uid==me() || managerOf(uid));
      allow create: if signed() && uid==me() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType in ['image/png','image/jpeg','application/pdf'];
      allow update, delete: if false;
    }
    match /{path=**}{allow read,write: if false;}
  }
}
