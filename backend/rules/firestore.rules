rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() {return request.auth != null;}
    function me(){return request.auth.uid;}
    function profile(){return get(/databases/$(database)/documents/users/$(me())).data;}
    function manager(){return signed() && profile().role in ['rh','admin'];}
    function isOwner(uid){return signed() && me() == uid;}
    function managedByMe(rhUid){return manager() && (profile().role=='admin' || rhUid==me());}
    match /users/{uid}{
      allow get: if isOwner(uid) || managedByMe(resource.data.rhUid);
      allow list: if signed() && managedByMe(resource.data.rhUid);  // Client query must constrain rhUid for RH.
      allow create,update,delete: if false;
    }
    match /directory/{uid}{
      allow read: if signed();
      allow write: if false;
    }
    match /requests/{id}{
      allow get,list: if signed() && (resource.data.ownerUid==me() || resource.data.swapWithUid==me() || managedByMe(resource.data.rhUid));
      allow create,update,delete: if false;
    }
    match /notifications/{id}{
      allow read: if signed() && resource.data.uid==me();
      allow create,update,delete: if false;
    }
    match /overrides/{id}{
      allow read: if signed() && (resource.data.uid==me() || managedByMe(resource.data.rhUid));
      allow create,update,delete: if false;
    }
    match /punches/{id}{
      allow read: if signed() && (resource.data.uid==me() || managedByMe(resource.data.rhUid));
      allow create,update,delete: if false;
    }
    match /closures/{id}{
      allow read: if signed() && (resource.data.uid==me() || managedByMe(resource.data.rhUid));
      allow create,update,delete: if false;
    }
    match /settings/{id}{
      allow read: if signed();
      allow create,update,delete: if false;
    }
    match /audits/{id}{
      allow read: if managedByMe(resource.data.rhUid);
      allow create,update,delete: if false;
    }
    match /accessLogs/{id}{
      allow read: if signed() && (resource.data.uid==me() || managedByMe(resource.data.rhUid));
      allow create,update,delete: if false;
    }
    match /{document=**}{allow read,write: if false;}
  }
}
